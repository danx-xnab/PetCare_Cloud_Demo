# Copy this file to .env on your ECS server, then fill in your own values.
# Do not commit .env. It is already ignored by .gitignore.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PETCARE_LLM_MODEL=gpt-4.1-mini
PETCARE_USE_SYSTEM_PROXY=

# Optional: Huawei Cloud OBS avatar storage.
# Keep PETCARE_STORAGE=local if you do not want to use OBS.
PETCARE_STORAGE=local
OBS_BUCKET=cloudhw2
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
OBS_PREFIX=petcare-uploads

# Optional: FunctionGraph callback token.
# Use the same value in Huawei Cloud FunctionGraph env PETCARE_FUNCTION_TOKEN.
PETCARE_FUNCTION_TOKEN=

# Optional: local message queue demo.
# This simulates DMS/RocketMQ with SQLite for classroom demonstration.
PETCARE_QUEUE_MODE=local-demo
PETCARE_QUEUE_TOPIC=petcare.record.events
